# =========================================================================
# DV Performing Arts - Environment Variables Example
# =========================================================================
# Copy this file to .env.local for local development.
# Do NOT commit real credentials or secrets to the repository.
# =========================================================================

# Database Connection (Future PostgreSQL / Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/dv_performing_arts?schema=public"

# NextAuth Configuration (Future Authentication)
# Generate a secret via: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-key-placeholder"
# The base URL of the auth endpoints
AUTH_URL="http://localhost:3000"

# Site Identity & Canonical URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="DV Performing Arts"

# Site Indexation Controls (SEO)
# Set to true only in production environment when ready to index
SITE_INDEXING_ENABLED=false

# Object Storage (Future asset storage for media, productions, etc.)
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Stripe Integration (Future single/recurring payments)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Service (Resend)
EMAIL_FROM="DV Performing Arts <no-reply@dvperformingarts.com>"
RESEND_API_KEY="re_..."

# Evolution API Integration (Future WhatsApp messages)
EVOLUTION_API_URL="https://evolution-api.example.com"
EVOLUTION_API_KEY="apikey_..."
EVOLUTION_INSTANCE="dv_instance"

# Manifiesto 21 Editorial Motor (Future Blog integration)
MANIFIESTO21_API_URL="https://manifiesto21-api.example.com"
MANIFIESTO21_API_KEY="m21_..."
MANIFIESTO21_TENANT_ID="m21_tenant_id"
MANIFIESTO21_WEBHOOK_SECRET="m21_whsec_..."
